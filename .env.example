# Copy to ".env.local" (gitignored) and fill in real values. Never commit secrets.

# --- RCA BLK Studio (admin at /studio) ---
# Password shared by team members who may edit content.
STUDIO_PASSWORD=

# Min 16 characters; used to sign the studio session cookie.
STUDIO_JWT_SECRET=

# --- Supabase (CMS: events, news, site pages, image uploads) ---
# Project: Dashboard → Settings → API
# URL: Project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (JWT, "anon" / "public" in dashboard). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role secret (JWT, "service_role" in dashboard). Server-only — Studio API routes + seed/admin writes.
# Do NOT prefix with NEXT_PUBLIC_. Do NOT commit this value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical site URL for metadata
NEXT_PUBLIC_SITE_URL=https://rcablk.com

# Optional: contact form POST endpoint (see ContactForm)
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
