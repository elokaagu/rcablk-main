# --- RCA BLK Studio (admin at /studio) ---
# Password shared by team members who may edit content.
STUDIO_PASSWORD=

# Min 16 characters; used to sign the studio session cookie.
STUDIO_JWT_SECRET=

# --- Supabase (CMS: events + news + image uploads) ---
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL editor,
# then create a public Storage bucket named "media".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical site URL for metadata
NEXT_PUBLIC_SITE_URL=https://rcablk.com

# Optional: contact form POST endpoint (see ContactForm)
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
